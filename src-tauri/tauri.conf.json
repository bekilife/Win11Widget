{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Win11Widget",
  "version": "1.0.0",
  "identifier": "com.win11widget.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Win11Widget",
    "copyright": "© 2026 Win11Widget contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "macOS-style desktop widgets for Windows 11",
    "longDescription": "Desktop widgets for Windows 11 in the style of macOS: clock, calendar, now playing, weather and system monitor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
